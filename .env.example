# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth (hand-rolled JWT) ---
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis / RQ (Memurai locally) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (local dev; swapped for GCS later) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./backend/storage_data

# --- App ---
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000

# --- Web app (Phase 6): browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# --- Dev only: process uploads inside the API instead of a separate worker.
# Useful on Windows if the worker gives trouble. Never enable in production.
RUN_JOBS_INLINE=false
