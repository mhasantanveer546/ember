# API base URL. Restart `npx expo start` after changing (values are inlined at build time).
#  Android emulator:  http://10.0.2.2:8000
#  iOS simulator:     http://localhost:8000
#  Physical phone:    http://<your-computer-LAN-IP>:8000   (run the API with --host 0.0.0.0)
#  Deployed API:      https://<your-service>.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8000
